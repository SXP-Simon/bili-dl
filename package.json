    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^30.1.1",
    "lefthook": "^2.1.14",
    "oxlint": "^1.86.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^7.0.2",
